{
  "version": 2,
  "name": "prakweb2",
  "public": "html",
  "builds": [
    {
      "src": "html/**",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "img/**",
      "use": "@vercel/static"
    },
    {
      "src": "icon/**",
      "use": "@vercel/static"
    },
    {
      "src": "video/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/(?!css|img|icon|video|html)(.+\\.html)$",
      "dest": "/html/$1"
    },
    {
      "src": "^/(?!css|img|icon|video)(.*)$",
      "dest": "/html/$1"
    },
    {
      "src": "^/(css|img|icon|video)/(.+)$",
      "dest": "/$1/$2"
    }
  ]
}

{
  "version": 2,
  "name": "prakweb2",
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/html/index.html"
    },
    {
      "src": "^/(css|img|icon|video)/(.*)$",
      "dest": "/$1/$2"
    },
    {
      "src": "^/(.*\\.html)$",
      "dest": "/html/$1"
    }
  ]
}
